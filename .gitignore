# === Strict Zero-Image & Media Policy ===
# Images, textures, original client archives, and audio stay local (ArtCache) and NEVER enter Git.
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tga
*.ico
*.webp
*.psd
*.dds
*.svg
*.img
*.pkg
*.idx
*.wav
*.ogg
*.mp3
*.wmv
*.swf
*.map

# Local art & map caches (populated by tools/prepare-art-cache.py)
/client/Assets/StreamingAssets/ArtCache/
/client/Assets/StreamingAssets/ArtCache.meta
/client/Assets/StreamingAssets/LocalMaps/
/client/Assets/StreamingAssets/LocalMaps.meta
/client/Assets/StreamingAssets/Catalogs/
/client/Assets/StreamingAssets/Catalogs.meta
/local-runtime/

